<?xml version="1.0" encoding="UTF-8" ?>
<!--
  云主机 / Docker 上 FastDDS SHM 常失败（open_and_lock_file failed）。
  本配置禁用内置传输（含 SHM），仅用 UDPv4，避免 fastrtps_port* 报错。
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_transport</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="axion_udp_only" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_transport</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
